{
  "info": {
    "name": "Lab05 Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Happy path: active student with prerequisites registers (201 OK)",
      "item": [
        {
          "name": "Setup: student S_T1",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/S_T1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S_T1"
              ]
            }
          }
        },
        {
          "name": "Setup: course C_T1",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/C_T1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C_T1"
              ]
            }
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"result is OK\", () => pm.expect(pm.response.json().result).to.eql(\"OK\"));",
                  "pm.test(\"registrationID is a number\", () => pm.expect(pm.response.json().registrationID).to.be.a(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"S_T1\",\"courseID\":\"C_T1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
      ]
    },
